{
  "name": "npface-monorepo",
  "private": true,
  "description": "npface — 表情头盔 · 会表情的 AI 员工头像 / expressive helmet avatar for AI agents",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter npface-demo dev",
    "build": "pnpm --filter npface build && pnpm --filter npface-react build",
    "build:demo": "pnpm build && pnpm --filter npface-demo build",
    "build:all": "pnpm build && pnpm --filter npface-demo build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter npface test",
    "size": "node scripts/size.mjs",
    "assets": "pnpm build && node scripts/snapshots.mjs && node scripts/record.mjs",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm size",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,css}\"",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
